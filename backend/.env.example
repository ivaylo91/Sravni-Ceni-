# Supabase → Project Settings → Database → Connect → "Session pooler" (JDBC)
DATABASE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?reWriteBatchedInserts=true&sslmode=require
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=<database password>

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Само за проекти със стария HS256 JWT secret; при JWT Signing Keys оставете празно
SUPABASE_JWT_SECRET=

ADMIN_EMAILS=you@example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
